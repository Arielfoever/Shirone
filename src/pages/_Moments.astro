---
import { getImage } from "astro:assets";
import MomentSection from "@components/organisms/MomentSection.svelte";
import I18nKey from "@i18n/i18nKey";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { resolveImageAsset } from "@utils/asset-utils";
import { getSortedMoments } from "@utils/content-utils";
import {
	type ContentLocale,
	DEFAULT_LOCALE,
	routePrefixFor,
} from "@utils/i18n-routing";
import { resolveI18nText } from "@utils/i18n-utils";
import { url } from "@utils/url-utils";
import { momentsConfig, profileConfig } from "@/config";

/**
 * 说说页主体（`moments.astro` 与 `[locale]/[...slug].astro` 共用）。
 * 功能开关在调用方的路由层判断——关闭时本组件不会被渲染。
 */
const pageTitle = resolveI18nText(momentsConfig.title, I18nKey.moments);
const pageDescription = resolveI18nText(
	momentsConfig.description,
	I18nKey.momentsBanner,
);

const moments = await getSortedMoments();
const avatarAsset = await resolveImageAsset(profileConfig.avatar ?? "");
let avatar = typeof avatarAsset === "string" ? avatarAsset : avatarAsset.src;
let avatarSrcset: string | undefined;
let avatarWidth: number | undefined;
let avatarHeight: number | undefined;
if (typeof avatarAsset !== "string") {
	const candidates = await Promise.all(
		[64, 96].map(async (width) => ({
			width,
			image: await getImage({
				src: avatarAsset,
				width,
				format: "webp",
				quality: 72,
			}),
		})),
	);
	avatar = candidates[0].image.src;
	avatarSrcset = candidates
		.map(({ image, width }) => `${image.src} ${width}w`)
		.join(", ");
	avatarWidth = avatarAsset.width;
	avatarHeight = avatarAsset.height;
}
// 作者链接跟随页面语言前缀：`/zh/moments/` 下指向 `/zh/about/`。
const pageLocale: ContentLocale = Astro.locals.locale ?? DEFAULT_LOCALE;
const author = {
	name: profileConfig.name,
	avatar,
	avatarSrcset,
	avatarWidth,
	avatarHeight,
	url: url(`${routePrefixFor(pageLocale)}/about/`),
};
---

<MainGridLayout title={pageTitle} description={pageDescription} page="moments">
    <MomentSection {moments} {author} title={pageTitle} subtitle={pageDescription} client:visible></MomentSection>
</MainGridLayout>

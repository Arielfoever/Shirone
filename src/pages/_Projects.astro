---
/**
 * 项目页主体（`projects.astro` 与 `[locale]/[...slug].astro` 共用）：
 * 配置层规则在构建期结合数据层传入交互岛。
 * 功能开关在调用方的路由层判断——关闭时本组件不会被渲染。
 */
import ProjectSection from "@components/organisms/ProjectSection.svelte";
import I18nKey from "@i18n/i18nKey";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { resolveI18nText } from "@utils/i18n-utils";
import { projectsConfig } from "@/config/projectsConfig";
import { resolveProjectsData } from "@/utils/feature-data";

const pageTitle = resolveI18nText(projectsConfig.title, I18nKey.projects);
const pageDescription = resolveI18nText(
	projectsConfig.description,
	I18nKey.projectsBanner,
);

const items = resolveProjectsData(projectsConfig);
---

<MainGridLayout
	title={pageTitle}
	description={pageDescription}
	page="projects"
>
	<ProjectSection
		categories={projectsConfig.categories}
		items={items}
		title={pageTitle}
		subtitle={pageDescription}
		client:visible
	/>
</MainGridLayout>

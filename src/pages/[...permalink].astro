---
import { DEFAULT_LOCALE } from "@utils/i18n-routing";
import { collectPostRoutePaths, toPermalinkPaths } from "@utils/post-routes";
import PostDetail from "./_PostDetail.astro";

/**
 * 默认语言的站根级 permalink 路由：`/<permalink>/`
 * （frontmatter `permalink`，或开启全局 permalink 后的模板产物）。
 *
 * 非默认语言的 permalink 落在前缀之下，由 `[locale]/[...slug]` 一并承接。
 */
export async function getStaticPaths() {
	const { permalinks } = await collectPostRoutePaths(DEFAULT_LOCALE);
	return toPermalinkPaths(permalinks);
}
---

<PostDetail {...Astro.props} />

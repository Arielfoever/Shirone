---
/**
 * 时间线页主体（`timeline.astro` 与 `[locale]/[...slug].astro` 共用）：
 * 配置层规则在构建期结合数据层传入交互岛。
 * 功能开关在调用方的路由层判断——关闭时本组件不会被渲染。
 */
import TimelineSection from "@components/organisms/TimelineSection.svelte";
import I18nKey from "@i18n/i18nKey";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { resolveI18nText } from "@utils/i18n-utils";
import { timelineConfig } from "@/config/timelineConfig";
import { resolveTimelineData } from "@/utils/feature-data";

const pageTitle = resolveI18nText(timelineConfig.title, I18nKey.timeline);
const pageDescription = resolveI18nText(
	timelineConfig.description,
	I18nKey.timelineBanner,
);

const items = resolveTimelineData(timelineConfig);
---

<MainGridLayout
	title={pageTitle}
	description={pageDescription}
	page="timeline"
>
	<TimelineSection
		categories={timelineConfig.categories}
		items={items}
		title={pageTitle}
		subtitle={pageDescription}
		client:visible
	/>
</MainGridLayout>

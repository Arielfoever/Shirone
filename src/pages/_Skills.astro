---
/**
 * 技能页主体（`skills.astro` 与 `[locale]/[...slug].astro` 共用）：
 * 配置层规则在构建期结合数据层传入交互岛。
 * 功能开关在调用方的路由层判断——关闭时本组件不会被渲染。
 */
import SkillSection from "@components/organisms/SkillSection.svelte";
import I18nKey from "@i18n/i18nKey";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { resolveI18nText } from "@utils/i18n-utils";
import { skillsConfig } from "@/config/skillsConfig";
import { resolveSkillsData } from "@/utils/feature-data";

const pageTitle = resolveI18nText(skillsConfig.title, I18nKey.skills);
const pageDescription = resolveI18nText(
	skillsConfig.description,
	I18nKey.skillsBanner,
);

const items = resolveSkillsData(skillsConfig);
---

<MainGridLayout
	title={pageTitle}
	description={pageDescription}
	page="skills"
>
	<SkillSection
		categories={skillsConfig.categories}
		items={items}
		title={pageTitle}
		subtitle={pageDescription}
		client:visible
	/>
</MainGridLayout>

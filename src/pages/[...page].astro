---
import type { GetStaticPaths } from "astro";
import { postListConfig } from "@/config/postListConfig";
import HomeList from "../layouts/HomeList.astro";
import { getSortedPostsForHome } from "../utils/content-utils";

export const getStaticPaths = (async ({ paginate }) => {
	// 语言范围由 postListConfig.languageScope 决定（默认 language = 现状）
	const allBlogPosts = await getSortedPostsForHome();
	return paginate(allBlogPosts, { pageSize: postListConfig.pageSize });
}) satisfies GetStaticPaths;
// https://github.com/withastro/astro/issues/6507#issuecomment-1489916992

const { page } = Astro.props;
---

<HomeList page={page} />

---
import type { CollectionEntry } from "astro:content";
import { CONTENT_LOCALES, DEFAULT_LOCALE } from "@utils/i18n-routing";
import {
	collectPostRoutePaths,
	type PostRoutePath,
	type PostRouteProps,
	toSlugPaths,
	withFallbackSlugs,
} from "@utils/post-routes";
import PostDetail from "../_PostDetail.astro";
import PostFallback from "../_PostFallback.astro";

/**
 * 默认语言的文章段路由：`/posts/<slug>/`（含 frontmatter `alias` 别名）。
 *
 * 条目筛选、推荐与系列上下文都在 `@utils/post-routes`；语言中立 slug 与
 * URL 的对应关系见 `@utils/i18n-routing`（非默认语言由 `[locale]/` 动态
 * 路由按 `contentI18n.locales` 承接）。
 *
 * 与 `[locale]/[...slug]` 对称的语言回退：**任何非默认语言**独有的文章
 * 在这里也产出 `/posts/<slug>/` 桥接页（`fallback: true` → `_PostFallback`，
 * 界面语言跟随默认语言），避免默认语言列表的跨语言卡片 404 或跳变顶栏。
 * 多语言同名 slug 按语言表顺序首条优先；语言表只剩默认语言时回退分支
 * 自动关闭（没有前缀路由可承接桥接页）。
 */
export async function getStaticPaths() {
	const own = await collectPostRoutePaths(DEFAULT_LOCALE);

	const fallbackSlugs: PostRoutePath[] = [];
	for (const locale of CONTENT_LOCALES) {
		if (locale === DEFAULT_LOCALE) continue;
		fallbackSlugs.push(...(await collectPostRoutePaths(locale)).slugs);
	}
	if (fallbackSlugs.length === 0) return toSlugPaths(own.slugs);

	return toSlugPaths(withFallbackSlugs(own.slugs, fallbackSlugs));
}

// 分流：`fallback` 标记 → 桥接页；否则渲染正文（`entry` 即 PostRouteProps）。
const props = Astro.props as PostRouteProps;
const entry = props.entry as CollectionEntry<"posts">;
---

{props.fallback ? (
	<PostFallback entry={entry} />
) : (
	<PostDetail {...props} />
)}

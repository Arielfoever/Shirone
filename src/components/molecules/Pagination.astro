---
import PagePagination from "@components/atoms/blog/PagePagination.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
/**
 * 分页器（消费 blog/PagePagination 原子）。
 * 页码窗口算法在原子内，这里只做 Astro Page → 原子 props 的映射
 * 与文案 i18n（原子不硬编码文案）。
 */
import type { Page } from "astro";
import { url } from "../../utils/url-utils";

interface Props {
	page: Page;
	class?: string;
	style?: string;
}

const { page, style } = Astro.props;
const className = Astro.props.class;

// 页码 URL 由当前页推导前缀：列表分页在非默认语言下带前缀（/zh/、/ja/2/），
// 页码段始终是尾部纯数字段，去掉它得到列表根（/、/zh/、/ja/）。不能写死
// `/${p}/`——那会把前缀语言的分页链到默认语言页。
const base = page.url.current.replace(/\d+\/$/, "");
const getPageUrl = (p: number) => (p === 1 ? base : `${base}${p}/`);
const buildUrl = (p: number) => url(getPageUrl(p));

const labels = {
	prev: i18n(I18nKey.paginationPrev),
	next: i18n(I18nKey.paginationNext),
	page: i18n(I18nKey.paginationPage),
	jump: i18n(I18nKey.paginationJump),
};
---

<PagePagination
	class={className}
	style={style}
	currentPage={page.currentPage}
	totalPages={page.lastPage}
	buildUrl={buildUrl}
	{labels}
/>
